#!/bin/sh
# Generated by the virtual-machine-run-command module from its
# script_files input. Writes each script to a private working directory
# and runs them one at a time, in the order given, stopping at the
# first script that exits non-zero and exiting with its code.
#
# Each script runs under the interpreter named in its shebang (bash
# when it has none), in its own process, so an `exit` or `set -e` in
# one script cannot end or change the others. Named parameters reach
# every script as environment variables and nameless ones as
# positional arguments, as they would for a single script. Carriage
# returns are stripped, so scripts saved with Windows line endings
# still run.
set -u

workdir=$(mktemp -d) || exit 1
trap 'rm -rf "$workdir"' EXIT

# Runs a script file, passing it the remaining arguments. Follows the
# kernel's shebang rules - an interpreter path and at most one
# argument - but invokes the interpreter directly, so scripts still run
# where the temporary directory is mounted noexec.
run_script() {
  script=$1
  shift

  first_line=$(head -n 1 "$script")
  case $first_line in
    '#!'*)
      shebang=$(printf '%s' "$first_line" | sed 's/^#![[:space:]]*//; s/[[:space:]]*$//')
      interpreter=$${shebang%%[[:space:]]*}
      argument=$(printf '%s' "$${shebang#"$interpreter"}" | sed 's/^[[:space:]]*//')
      if [ -n "$argument" ]; then
        "$interpreter" "$argument" "$script" "$@"
      else
        "$interpreter" "$script" "$@"
      fi
      ;;
    *)
      if command -v bash >/dev/null 2>&1; then
        bash "$script" "$@"
      else
        sh "$script" "$@"
      fi
      ;;
  esac
}

# Write every script before running any, so a decoding failure stops
# the run before it has changed anything on the machine.
%{ for script in scripts ~}
printf '%s' '${script.content}' | base64 -d | tr -d '\r' > "$workdir/${script.name}" || {
  echo "Could not write ${script.name} to $workdir." >&2
  exit 1
}
%{ endfor ~}

%{ for index, script in scripts ~}
echo "==> [${index + 1}/${length(scripts)}] Running ${script.name}"
run_script "$workdir/${script.name}" "$@" || {
  status=$?
  echo "==> ${script.name} failed with exit code $status; the remaining scripts were not run." >&2
  exit $status
}

%{ endfor ~}
echo "==> All ${length(scripts)} scripts completed."
