# Generated by the virtual-machine-run-command module from its
# script_files input. Writes each script to a private working directory
# and runs them one at a time, in the order given, stopping at the
# first script that fails and exiting with its code.
#
# Each script runs in its own Windows PowerShell process, exactly as
# the Run Command service runs a single script, so an `exit`, a
# terminating error or a preference variable in one script cannot end
# or change the others. Every script is passed the run command's
# parameters that its param() block declares - or all of them when it
# has no param() block - so scripts need not share a parameter list.
param(
%{ for index, name in parameter_names ~}
    ${format("[string]$%s", name)}${index < length(parameter_names) - 1 ? "," : ""}
%{ endfor ~}
)

$ErrorActionPreference = 'Stop'

function Write-Status([string]$Message) {
    [Console]::Out.WriteLine($Message)
    [Console]::Out.Flush()
}

# Quotes an argument for a Windows command line, so values with
# spaces, quotes or trailing backslashes reach the script unchanged.
function ConvertTo-CommandLineArgument([string]$Value) {
    if ($Value -ne '' -and $Value -notmatch '[\s"]') {
        return $Value
    }
    $escaped = $Value -replace '(\\*)"', '$1$1\"'
    $escaped = $escaped -replace '(\\+)$', '$1$1'
    return '"' + $escaped + '"'
}

function Invoke-ScriptFiles([System.Collections.IDictionary]$Parameters) {
    $scripts = @(
%{ for script in scripts ~}
        @{ Name = '${script.name}'; Content = '${script.content}' }
%{ endfor ~}
    )

    $workDir = Join-Path ([IO.Path]::GetTempPath()) ('run-command-' + [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Path $workDir | Out-Null

    try {
        # Write and parse every script before running any, so a
        # syntax error stops the run before it has changed anything on
        # the machine.
        foreach ($script in $scripts) {
            $bytes = [Convert]::FromBase64String($script.Content)

            # Windows PowerShell reads a script without a byte order
            # mark as ANSI, so mark UTF-8 scripts to keep any non-ASCII
            # text intact.
            $hasBom = $bytes.Length -ge 2 -and (
                ($bytes[0] -eq 0xEF -and $bytes.Length -ge 3 -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) -or
                ($bytes[0] -eq 0xFF -and $bytes[1] -eq 0xFE) -or
                ($bytes[0] -eq 0xFE -and $bytes[1] -eq 0xFF))
            if (-not $hasBom) {
                $bytes = [byte[]](@(0xEF, 0xBB, 0xBF) + $bytes)
            }

            $script.Path = Join-Path $workDir $script.Name
            [IO.File]::WriteAllBytes($script.Path, $bytes)

            $tokens = $null
            $parseErrors = $null
            $ast = [System.Management.Automation.Language.Parser]::ParseFile($script.Path, [ref]$tokens, [ref]$parseErrors)
            if ($parseErrors.Count -gt 0) {
                $first = $parseErrors[0]
                throw "$($script.Name) line $($first.Extent.StartLineNumber): $($first.Message)"
            }

            $script.Declared = $null
            if ($ast.ParamBlock) {
                $script.Declared = @($ast.ParamBlock.Parameters | ForEach-Object { $_.Name.VariablePath.UserPath })
            }
        }

        $powershell = Join-Path $PSHOME 'powershell.exe'
        $index = 0
        foreach ($script in $scripts) {
            $index++
            Write-Status "==> [$index/$($scripts.Count)] Running $($script.Name)"

            $arguments = @('-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', (ConvertTo-CommandLineArgument $script.Path))
            foreach ($name in $Parameters.Keys) {
                if ($null -eq $script.Declared -or $script.Declared -contains $name) {
                    $arguments += "-$name"
                    $arguments += ConvertTo-CommandLineArgument ([string]$Parameters[$name])
                }
            }

            $startInfo = New-Object System.Diagnostics.ProcessStartInfo
            $startInfo.FileName = $powershell
            $startInfo.Arguments = $arguments -join ' '
            $startInfo.UseShellExecute = $false
            $startInfo.WorkingDirectory = $workDir
            $startInfo.RedirectStandardOutput = $true
            $startInfo.RedirectStandardError = $true

            # Relay the script's output into this process's streams,
            # where the Run Command service captures it. Standard error
            # is read in the background so neither pipe can fill and
            # stall the script.
            $process = [System.Diagnostics.Process]::Start($startInfo)
            $standardError = $process.StandardError.ReadToEndAsync()
            while ($null -ne ($line = $process.StandardOutput.ReadLine())) {
                [Console]::Out.WriteLine($line)
            }
            $process.WaitForExit()
            [Console]::Out.Flush()
            if ($standardError.Result) {
                [Console]::Error.Write($standardError.Result)
                [Console]::Error.Flush()
            }
            $exitCode = $process.ExitCode

            if ($exitCode -ne 0) {
                [Console]::Error.WriteLine("==> $($script.Name) failed with exit code $exitCode; the remaining scripts were not run.")
                return $exitCode
            }
        }

        Write-Status "==> All $($scripts.Count) scripts completed."
        return 0
    }
    finally {
        Remove-Item -LiteralPath $workDir -Recurse -Force -ErrorAction SilentlyContinue
    }
}

try {
    $exitCode = Invoke-ScriptFiles -Parameters $PSBoundParameters
}
catch {
    [Console]::Error.WriteLine("==> $($_.Exception.Message)")
    $exitCode = 1
}
exit $exitCode
